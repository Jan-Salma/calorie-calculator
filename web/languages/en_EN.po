msgctxt "info.fat_loss.carbs"
msgid ""
"Remaining — keep as high as possible to preserve training energy and "
"strength, which increases total calorie expenditure."
msgstr ""
"Remaining — keep as high as possible to preserve training energy and "
"strength, which increases total calorie expenditure."

msgctxt "info.fat_loss.fat"
msgid ""
"15–20% of calories — minimized but never below biological minimum. Fats are "
"essential for hormones (testosterone, estrogen) and fat-soluble vitamins A, "
"D, E, K."
msgstr ""
"15–20% of calories — minimized but never below biological minimum. Fats are "
"essential for hormones (testosterone, estrogen) and fat-soluble vitamins A, "
"D, E, K."

msgctxt "info.fat_loss.protein"
msgid ""
"2.2–2.4 g/kg — strongly protects muscle mass during caloric deficit. More "
"amino acids = less catabolism."
msgstr ""
"2.2–2.4 g/kg — strongly protects muscle mass during caloric deficit. More "
"amino acids = less catabolism."

msgctxt "info.fat_loss.text"
msgid ""
"In a deficit, the body burns both fat and muscle. Higher protein and "
"strength training are the main tools for preserving lean mass."
msgstr ""
"In a deficit, the body burns both fat and muscle. Higher protein and "
"strength training are the main tools for preserving lean mass."

msgctxt "info.fat_loss.title"
msgid "Macros for fat loss"
msgstr "Macros for fat loss"

msgctxt "info.muscle.carbs"
msgid ""
"Remaining calories — primary fuel for training, replenishes glycogen and "
"enables progressive overload."
msgstr ""
"Remaining calories — primary fuel for training, replenishes glycogen and "
"enables progressive overload."

msgctxt "info.muscle.fat"
msgid ""
"25–30% of calories — higher fat intake is essential for testosterone and "
"anabolic hormones critical for muscle growth."
msgstr ""
"25–30% of calories — higher fat intake is essential for testosterone and "
"anabolic hormones critical for muscle growth."

msgctxt "info.muscle.protein"
msgid ""
"1.8–2.0 g/kg — stimulates muscle protein synthesis (MPS). In a caloric "
"surplus, lower protein is sufficient compared to a deficit."
msgstr ""
"1.8–2.0 g/kg — stimulates muscle protein synthesis (MPS). In a caloric "
"surplus, lower protein is sufficient compared to a deficit."

msgctxt "info.muscle.text"
msgid ""
"The body can only synthesize ~300 kcal of muscle tissue per day naturally. A"
" larger surplus = fat, not muscle. A small, controlled surplus is optimal."
msgstr ""
"The body can only synthesize ~300 kcal of muscle tissue per day naturally. A"
" larger surplus = fat, not muscle. A small, controlled surplus is optimal."

msgctxt "info.muscle.title"
msgid "Macros for muscle building"
msgstr "Macros for muscle building"

msgctxt "info.recomp.carbs"
msgid ""
"Remaining — adequate glycogen supply for training. Results are slower than "
"pure bulk/cut, but without weight fluctuations."
msgstr ""
"Remaining — adequate glycogen supply for training. Results are slower than "
"pure bulk/cut, but without weight fluctuations."

msgctxt "info.recomp.fat"
msgid ""
"20–25% of calories — the golden mean for hormonal balance without limiting "
"training performance."
msgstr ""
"20–25% of calories — the golden mean for hormonal balance without limiting "
"training performance."

msgctxt "info.recomp.protein"
msgid ""
"1.8–2.2 g/kg — the middle range covers both processes: building and "
"protecting muscle. Higher intake = better results."
msgstr ""
"1.8–2.2 g/kg — the middle range covers both processes: building and "
"protecting muscle. Higher intake = better results."

msgctxt "info.recomp.text"
msgid ""
"Recomposition = simultaneous muscle building and fat loss at maintenance "
"calories. Most effective for beginners or those returning after a break."
msgstr ""
"Recomposition = simultaneous muscle building and fat loss at maintenance "
"calories. Most effective for beginners or those returning after a break."

