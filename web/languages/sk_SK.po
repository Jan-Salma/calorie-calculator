msgstr "📖 Ženy +200 kcal, max. 0,5–1 kg/mes. Ženy budujú svaly pomalšie."

msgctxt "recommend.muscle.m"
msgid "📖 Men +300 kcal, max. 1–1.5 kg/month. Clean gains without excess fat."
msgstr ""
"📖 Muži +300 kcal, max. 1–1,5 kg/mes. Čistý rast bez nadbytočného tuku."

msgctxt "recomp.eta"
