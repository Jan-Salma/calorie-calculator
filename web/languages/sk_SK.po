msgctxt "recommend.fat_loss"
msgid "📖 A 300 kcal/day deficit is the ideal start. Goal: 0.5–1 kg/week."
msgstr "📖 Deficit 300 kcal/deň je ideálny štart. Cieľ: 0,5–1 kg/týždeň."

msgctxt "recommend.muscle.f"
